Sub ConvertDates_YYYYMMDD_to_DDMMYYYY()

    Dim rng As Range
    Set rng = ActiveDocument.Content

    With rng.Find
        .ClearFormatting
        .Text = "([0-9]{4})-([0-9]{2})-([0-9]{2})"
        .Replacement.Text = "\3-\2-\1"
        .Forward = True
        .Wrap = wdFindContinue
        .Format = False
        .MatchWildcards = True
        .Execute Replace:=wdReplaceAll
    End With

    MsgBox "All dates converted from YYYY-MM-DD to DD-MM-YYYY", vbInformation

End Sub






