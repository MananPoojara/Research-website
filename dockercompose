version: '3.9'

services:

  postgres:
    image: timescale/timescaledb:2.15.1-pg16
    container_name: yt-postgres
    environment:
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: admin123
      POSTGRES_DB: youngturtle
    volumes:
      - ../infra/volumes/postgres:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    restart: always

  redis:
    image: redis:7
    container_name: yt-redis
    volumes:
      - ../infra/volumes/redis:/data
    ports:
      - "6379:6379"
    restart: always

  minio:
    image: minio/minio
    container_name: yt-minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: admin
      MINIO_ROOT_PASSWORD: admin12345
    volumes:
      - ../infra/volumes/minio:/data
    ports:
      - "9000:9000"
      - "9001:9001"
    restart: always

  backend:
    image: node:18
    container_name: yt-backend
    working_dir: /app
    volumes:
      - ../backend:/app
    command: ["npm", "run", "dev"]
    ports:
      - "3001:3001"
    depends_on:
      - postgres
      - redis
      - minio
    restart: unless-stopped

  frontend:
    image: node:18
    container_name: yt-frontend
    working_dir: /app
    volumes:
      - ../frontend:/app
    command: ["npm", "run", "dev"]
    ports:
      - "3000:3000"
    depends_on:
      - backend
    restart: unless-stopped

  nginx:
    image: nginx
    container_name: yt-nginx
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf
    ports:
      - "80:80"
      - "443:443"
    depends_on:
      - frontend
      - backend
    restart: always




docker-compose 


#--------------------------------------------------------------------------------------------------#


server {
    listen 80;
    server_name _;

    location /api/ {
        proxy_pass http://backend:3001/;
    }

    location / {
        proxy_pass http://frontend:3000/;
    }
}


