#!/bin/bash

export PGPASSWORD="your_pg_password"  # Or use ~/.pgpass
DB_NAME="your_database_name"
DB_USER="postgres"
DB_HOST="localhost"

MC_ALIAS="minio"
BUCKET="timescaledb-backups"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="${DB_NAME}_${TIMESTAMP}.dump"

echo "Backup starting: $(date)"

pg_dump -Fc -h $DB_HOST -U $DB_USER $DB_NAME | \
  mc pipe $MC_ALIAS/$BUCKET/$BACKUP_FILE

if [ $? -eq 0 ]; then
  echo "Success: $BACKUP_FILE uploaded"
else
  echo "Failed!"
  exit 1
fi



